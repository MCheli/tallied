# Tallied — Environment Variables
# Copy this to .env and fill in your values

# Database — leave empty for SQLite (default), or set for Postgres
# FINANCE_DATABASE_URL=postgresql://tallied:tallied_dev@localhost:5432/tallied

# AI Document Parsing (required for import workflow)
FINANCE_ANTHROPIC_API_KEY=sk-ant-...

# Plaid Bank Sync (optional)
# FINANCE_PLAID_CLIENT_ID=
# FINANCE_PLAID_SECRET=

# Auth
FINANCE_SECRET_KEY=change-this-to-a-random-string-in-production
FINANCE_DEV_MODE=true

# Google SSO (required for production, optional for dev)
# FINANCE_GOOGLE_CLIENT_ID=
# FINANCE_GOOGLE_CLIENT_SECRET=

# App URL (used for OAuth redirect)
FINANCE_BASE_URL=http://localhost:8000
