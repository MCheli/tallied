# Database
FINANCE_DATABASE_URL=postgresql://tallied:CHANGE_ME@localhost/tallied

# Security — MUST change in production
FINANCE_SECRET_KEY=GENERATE_WITH_python_-c_"import secrets; print(secrets.token_urlsafe(64))"

# AI Services
FINANCE_ANTHROPIC_API_KEY=sk-ant-...

# Auth — Google SSO
FINANCE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
FINANCE_GOOGLE_CLIENT_SECRET=your-secret

# Dev mode (set to false in production)
FINANCE_DEV_MODE=false
FINANCE_DEV_USER_EMAIL=admin@tallied.dev
FINANCE_DEV_USER_PASSWORD=change-me

# Optional
FINANCE_RAPIDAPI_KEY=              # RapidAPI key for Realtor.com property valuations
FINANCE_PLAID_CLIENT_ID=
FINANCE_PLAID_SECRET=
FINANCE_BASE_URL=https://your-domain.com
FINANCE_RATE_LIMIT_PER_HOUR=1000
